{
  "name": "banyan-cloud-ui",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "dependencies": {
    "@banyan_cloud/roots": "2.0.2",
    "@highcharts/map-collection": "^2.1.0",
    "@tanstack/react-query": "^4.32.6",
    "@tanstack/react-query-devtools": "^4.32.6",
    "aws-amplify": "^6.10.0",
    "crypto-js": "4.1.1",
    "d3": "^7.9.0",
    "fast-equals": "5.0.1",
    "framer-motion": "^11.0.3",
    "highcharts": "^11.1.0",
    "highcharts-react-official": "^3.2.1",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-error-boundary": "^4.0.10",
    "react-grid-layout": "1.3.4",
    "react-hook-form": "^7.45.4",
    "react-idle-timer": "^5.7.2",
    "react-lottie": "^1.2.3",
    "react-redux": "^8.1.1",
    "react-resizable": "3.0.5",
    "react-resize-detector": "9.1.0",
    "react-router-dom": "6.14.1",
    "redux": "^4.2.1",
    "uuid": "11.1.0",
    "web-vitals": "3.3.2",
    "zustand": "^5.0.0"
  },
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "serve": "vite preview",
    "lint": "eslint --ext js,jsx .",
    "lint:fix": "eslint --ext js,jsx . --fix",
    "format": "prettier --write './**/*.{js,jsx,ts,tsx,md,json}' --config ./.prettierrc",
    "test": "jest",
    "coverage": "jest --coverage",
    "knip": "knip",
    "sourceSize": "du -sh ./src/*"
  },
  "peerDependencies": {
    "react-spring": "^9.x"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ],
    "overrides": [
      {
        "files": [
          ""
        ],
        "rules": {
          "import/no-anonymous-default-export": "off"
        }
      }
    ]
  },
  "browserslist": {
    "production": [
      ">2%",
      "not dead",
      "not ie<=11",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "jest": {
    "collectCoverage": false,
    "globals": {
      "ts-jest": {
        "useESM": true
      }
    },
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "src/**/*.{js,jsx}",
      "!src/**/*.test.{js,jsx}",
      "!src/**/__tests__/*.{js,jsx}"
    ],
    "transform": {
      "^.+\\.[t|j]sx?$": "babel-jest",
      "^.+\\.css$": "jest-transform-stub"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(module))",
      "node_modules/(?!(d3|d3-array|d3-scale|d3-selection|d3-format|d3-time|d3-time-format|internmap|delaunator|robust-predicates)/)"
    ],
    "moduleFileExtensions": [
      "js",
      "jsx",
      "ts",
      "tsx"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "\\.(css|less|scss|sass)$": "identity-obj-proxy",
      "^d3$": "<rootDir>/node_modules/d3/dist/d3.js",
      "^d3-(.*)$": "<rootDir>/node_modules/d3-$1/dist/d3-$1.js"
    },
    "coverageReporters": [
      "json",
      "lcov",
      "text",
      "clover"
    ],
    "testMatch": [
      "**/?(*.)+(test).[jt]s?(x)"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/build/",
      "/coverage/"
    ],
    "testEnvironment": "jest-environment-jsdom",
    "testResultsProcessor": "jest-sonar-reporter"
  },
  "pnpm": {
    "overrides": {
      "uuid": "10.0.0"
    }
  },
  "devDependencies": {
    "@babel/preset-env": "^7.24.7",
    "@babel/preset-react": "^7.24.7",
    "@hookform/devtools": "^4.3.1",
    "@locator/babel-jsx": "^0.2.2",
    "@locator/runtime": "^0.2.2",
    "@redux-devtools/extension": "^3.3.0",
    "@testing-library/jest-dom": "^6.4.6",
    "@testing-library/react": "^16.0.0",
    "@vitejs/plugin-react": "4.0.3",
    "babel-jest": "^29.7.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-plugin-named-exports-order": "^0.0.2",
    "babel-preset-vite": "^1.1.3",
    "constructs": "^10.0.0",
    "esbuild": "^0.24.0",
    "eslint": "^8.2.0",
    "eslint-config-airbnb": "19.0.4",
    "eslint-config-prettier": "^8.5.0",
    "eslint-import-resolver-custom-alias": "^1.3.2",
    "eslint-plugin-import": "^2.25.3",
    "eslint-plugin-jest": "^28.6.0",
    "eslint-plugin-jsx-a11y": "^6.5.1",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-react": "^7.28.0",
    "eslint-plugin-react-hooks": "^4.3.0",
    "global": "^4.4.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-canvas-mock": "^2.5.2",
    "jest-environment-jsdom": "^29.7.0",
    "jest-sonar-reporter": "^2.0.0",
    "jest-transform-stub": "^2.0.0",
    "knip": "^5.50.4",
    "madge": "^8.0.0",
    "prettier": "^2.7.1",
    "prop-types": "^15.8.1",
    "redux-mock-store": "^1.5.4",
    "roots": "link:@types/@banyan_cloud/roots",
    "sass": "1.63.6",
    "typescript": "^5.0.0",
    "vite": "^4.4.7",
    "vite-plugin-eslint": "^1.8.1",
    "vite-plugin-svgr": "^3.2.0",
    "whatwg-fetch": "^3.6.20"
  }
}
